[{"id": "EX_G7_ADD_01", "knowledgeTitle": "有理数加法", "grade": "初一", "difficulty": 1, "type": "choice", "question": "计算：$(-3)+(-5)$", "options": ["$-8$", "$8$", "$-2$", "$2$"], "answer": "$-8$", "solution": "同号相加，取相同符号，绝对值相加：$-(3+5)=-8$。", "source": "local"}, {"id": "EX_G7_ADD_02", "knowledgeTitle": "有理数加法", "grade": "初一", "difficulty": 2, "type": "choice", "question": "计算：$(-7)+4$", "options": ["$-3$", "$3$", "$-11$", "$11$"], "answer": "$-3$", "solution": "异号相加，取绝对值较大的符号，再用较大绝对值减较小绝对值：$-(7-4)=-3$。", "source": "local"}, {"id": "EX_G7_ADD_03", "knowledgeTitle": "有理数加法", "grade": "初一", "difficulty": 3, "type": "choice", "question": "计算：$5+(-12)+7$", "options": ["$0$", "$24$", "$-24$", "$14$"], "answer": "$0$", "solution": "先算 $5+7=12$，再算 $12+(-12)=0$。", "source": "local"}, {"id": "EX_G7_SUB_01", "knowledgeTitle": "有理数减法", "grade": "初一", "difficulty": 1, "type": "choice", "question": "计算：$3-(-5)$", "options": ["$8$", "$-8$", "$-2$", "$2$"], "answer": "$8$", "solution": "减去一个数等于加上它的相反数：$3+5=8$。", "source": "local"}, {"id": "EX_G7_SUB_02", "knowledgeTitle": "有理数减法", "grade": "初一", "difficulty": 2, "type": "choice", "question": "计算：$-4-6$", "options": ["$-10$", "$10$", "$-2$", "$2$"], "answer": "$-10$", "solution": "$-4-6=-4+(-6)=-10$。", "source": "local"}, {"id": "EX_G7_SUB_03", "knowledgeTitle": "有理数减法", "grade": "初一", "difficulty": 3, "type": "choice", "question": "计算：$-2-(-7)$", "options": ["$5$", "$-5$", "$9$", "$-9$"], "answer": "$5$", "solution": "$-2+7=5$。", "source": "local"}, {"id": "EX_G7_MUL_01", "knowledgeTitle": "有理数乘法", "grade": "初一", "difficulty": 1, "type": "choice", "question": "计算：$(-3)\\times 4$", "options": ["$-12$", "$12$", "$-7$", "$7$"], "answer": "$-12$", "solution": "异号相乘得负，绝对值相乘：$-(3\\times 4)=-12$。", "source": "local"}, {"id": "EX_G7_MUL_02", "knowledgeTitle": "有理数乘法", "grade": "初一", "difficulty": 2, "type": "choice", "question": "计算：$(-5)\\times(-6)$", "options": ["$30$", "$-30$", "$-11$", "$11$"], "answer": "$30$", "solution": "同号相乘得正，绝对值相乘：$5\\times 6=30$。", "source": "local"}, {"id": "EX_G7_MUL_03", "knowledgeTitle": "有理数乘法", "grade": "初一", "difficulty": 3, "type": "choice", "question": "计算：$(-2)\\times 3\\times(-5)$", "options": ["$30$", "$-30$", "$10$", "$-10$"], "answer": "$30$", "solution": "先定符号：两个负号得正；再算 $2\\times 3\\times 5=30$。", "source": "local"}, {"id": "EX_G7_DIV_01", "knowledgeTitle": "有理数除法", "grade": "初一", "difficulty": 1, "type": "choice", "question": "计算：$(-12)\\div 3$", "options": ["$-4$", "$4$", "$-9$", "$9$"], "answer": "$-4$", "solution": "异号相除得负，$12\\div 3=4$，所以结果是 $-4$。", "source": "local"}, {"id": "EX_G7_DIV_02", "knowledgeTitle": "有理数除法", "grade": "初一", "difficulty": 2, "type": "choice", "question": "计算：$(-36)\\div(-9)$", "options": ["$4$", "$-4$", "$27$", "$-27$"], "answer": "$4$", "solution": "同号相除得正，$36\\div 9=4$。", "source": "local"}, {"id": "EX_G7_DIV_03", "knowledgeTitle": "有理数除法", "grade": "初一", "difficulty": 3, "type": "choice", "question": "计算：$\\left(-\\frac{3}{4}\\right)\\div\\frac{3}{8}$", "options": ["$-2$", "$2$", "$-\\frac{1}{2}$", "$\\frac{1}{2}$"], "answer": "$-2$", "solution": "除以一个分数等于乘它的倒数：$-\\frac{3}{4}\\times\\frac{8}{3}=-2$。", "source": "local"}, {"id": "EX_G7_POW_01", "knowledgeTitle": "有理数乘方", "grade": "初一", "difficulty": 1, "type": "choice", "question": "计算：$(-2)^3$", "options": ["$-8$", "$8$", "$-6$", "$6$"], "answer": "$-8$", "solution": "$(-2)^3=(-2)\\times(-2)\\times(-2)=-8$。", "source": "local"}, {"id": "EX_G7_POW_02", "knowledgeTitle": "有理数乘方", "grade": "初一", "difficulty": 2, "type": "choice", "question": "计算：$-3^2$", "options": ["$-9$", "$9$", "$-6$", "$6$"], "answer": "$-9$", "solution": "$3^2=9$，前面的负号保留，所以是 $-9$。", "source": "local"}, {"id": "EX_G7_POW_03", "knowledgeTitle": "有理数乘方", "grade": "初一", "difficulty": 3, "type": "choice", "question": "计算：$\\left(-\\frac{1}{2}\\right)^3$", "options": ["$-\\frac{1}{8}$", "$\\frac{1}{8}$", "$-\\frac{1}{6}$", "$\\frac{1}{6}$"], "answer": "$-\\frac{1}{8}$", "solution": "$(-1)^3=-1$，$2^3=8$，所以是 $-\\frac{1}{8}$。", "source": "local"}, {"id": "EX_G7_LIKE_01", "knowledgeTitle": "合并同类项", "grade": "初一", "difficulty": 1, "type": "choice", "question": "化简：$3x+2y-5x+4y$", "options": ["$-2x+6y$", "$2x+6y$", "$-2x-6y$", "$8x+6y$"], "answer": "$-2x+6y$", "solution": "合并 $x$ 项：$3x-5x=-2x$；合并 $y$ 项：$2y+4y=6y$。", "source": "local"}, {"id": "EX_G7_LIKE_02", "knowledgeTitle": "合并同类项", "grade": "初一", "difficulty": 2, "type": "choice", "question": "化简：$5a^2-3a+2a^2+4a$", "options": ["$7a^2+a$", "$7a^2-a$", "$3a^2+a$", "$7a^4+a$"], "answer": "$7a^2+a$", "solution": "$a^2$ 项：$5a^2+2a^2=7a^2$；$a$ 项：$-3a+4a=a$。", "source": "local"}, {"id": "EX_G7_LIKE_03", "knowledgeTitle": "合并同类项", "grade": "初一", "difficulty": 3, "type": "choice", "question": "化简：$2(x-3y)-3(x-2y)$", "options": ["$-x$", "$x$", "$-x-12y$", "$-5x$"], "answer": "$-x$", "solution": "去括号：$2x-6y-3x+6y$，$x$ 项 $-x$，$y$ 项为 $0$。", "source": "local"}, {"id": "EX_G7_BRACKET_01", "knowledgeTitle": "去括号法则", "grade": "初一", "difficulty": 1, "type": "choice", "question": "去括号：$a+(b-c)$", "options": ["$a+b-c$", "$a-b+c$", "$a-b-c$", "$a+b+c$"], "answer": "$a+b-c$", "solution": "括号前是 $+$，去括号后符号不变。", "source": "local"}, {"id": "EX_G7_BRACKET_02", "knowledgeTitle": "去括号法则", "grade": "初一", "difficulty": 2, "type": "choice", "question": "去括号：$a-(b-c)$", "options": ["$a-b+c$", "$a+b-c$", "$a+b+c$", "$a-b-c$"], "answer": "$a-b+c$", "solution": "括号前是 $-$，去括号后括号内各项都变号。", "source": "local"}, {"id": "EX_G7_BRACKET_03", "knowledgeTitle": "去括号法则", "grade": "初一", "difficulty": 3, "type": "choice", "question": "去括号：$-2(3x-4y+1)$", "options": ["$-6x+8y-2$", "$-6x-8y-2$", "$6x+8y-2$", "$-6x+8y+2$"], "answer": "$-6x+8y-2$", "solution": "用 $-2$ 乘括号内每一项：$-6x+8y-2$。", "source": "local"}, {"id": "EX_G7_EQ_01", "knowledgeTitle": "一元一次方程解法", "grade": "初一", "difficulty": 1, "type": "choice", "question": "解方程：$2x+5=13$", "options": ["$x=4$", "$x=9$", "$x=6.5$", "$x=-4$"], "answer": "$x=4$", "solution": "移项：$2x=8$，两边除以 $2$：$x=4$。", "source": "local"}, {"id": "EX_G7_EQ_02", "knowledgeTitle": "一元一次方程解法", "grade": "初一", "difficulty": 2, "type": "choice", "question": "解方程：$3x-7=8$", "options": ["$x=5$", "$x=3$", "$x=\\frac{1}{3}$", "$x=15$"], "answer": "$x=5$", "solution": "移项：$3x=15$，两边除以 $3$：$x=5$。", "source": "local"}, {"id": "EX_G7_EQ_03", "knowledgeTitle": "一元一次方程解法", "grade": "初一", "difficulty": 3, "type": "choice", "question": "解方程：$\\frac{x-1}{2}+1=3$", "options": ["$x=5$", "$x=3$", "$x=7$", "$x=4$"], "answer": "$x=5$", "solution": "先移项：$\\frac{x-1}{2}=2$，去分母得 $x-1=4$，所以 $x=5$。", "source": "local"}, {"id": "EX_G7_MOVE_01", "knowledgeTitle": "移项法则", "grade": "初一", "difficulty": 1, "type": "choice", "question": "解方程：$2x+3=7x-12$", "options": ["$x=3$", "$x=-3$", "$x=5$", "$x=-5$"], "answer": "$x=3$", "solution": "移项：$3+12=7x-2x$，即 $15=5x$，所以 $x=3$。", "source": "local"}, {"id": "EX_G7_MOVE_02", "knowledgeTitle": "移项法则", "grade": "初一", "difficulty": 2, "type": "choice", "question": "解方程：$5x-4=2x+8$", "options": ["$x=4$", "$x=12$", "$x=\\frac{4}{3}$", "$x=-4$"], "answer": "$x=4$", "solution": "移项：$5x-2x=8+4$，$3x=12$，所以 $x=4$。", "source": "local"}, {"id": "EX_G7_MOVE_03", "knowledgeTitle": "移项法则", "grade": "初一", "difficulty": 3, "type": "choice", "question": "解方程：$3(x-2)=2x+1$", "options": ["$x=7$", "$x=5$", "$x=-7$", "$x=1$"], "answer": "$x=7$", "solution": "去括号：$3x-6=2x+1$，移项得 $x=7$。", "source": "local"}, {"id": "EX_G7_SUB_SYS_01", "knowledgeTitle": "代入消元法", "grade": "初一", "difficulty": 1, "type": "choice", "question": "解方程组：$\\begin{cases}x+y=5\\\\x-y=1\\end{cases}$", "options": ["$x=3,\\ y=2$", "$x=2,\\ y=3$", "$x=4,\\ y=1$", "$x=1,\\ y=4$"], "answer": "$x=3,\\ y=2$", "solution": "两式相加得 $2x=6$，$x=3$；代回 $x+y=5$ 得 $y=2$。", "source": "local"}, {"id": "EX_G7_SUB_SYS_02", "knowledgeTitle": "代入消元法", "grade": "初一", "difficulty": 2, "type": "choice", "question": "解方程组：$\\begin{cases}y=2x\\\\x+y=9\\end{cases}$", "options": ["$x=3,\\ y=6$", "$x=6,\\ y=3$", "$x=2,\\ y=4$", "$x=4,\\ y=8$"], "answer": "$x=3,\\ y=6$", "solution": "把 $y=2x$ 代入 $x+y=9$：$3x=9$，$x=3$，所以 $y=6$。", "source": "local"}, {"id": "EX_G7_SUB_SYS_03", "knowledgeTitle": "代入消元法", "grade": "初一", "difficulty": 3, "type": "choice", "question": "解方程组：$\\begin{cases}2x+y=7\\\\y=x+1\\end{cases}$", "options": ["$x=2,\\ y=3$", "$x=3,\\ y=2$", "$x=1,\\ y=2$", "$x=2,\\ y=1$"], "answer": "$x=2,\\ y=3$", "solution": "把 $y=x+1$ 代入：$2x+x+1=7$，$3x=6$，$x=2$，所以 $y=3$。", "source": "local"}, {"id": "EX_G7_ADD_SYS_01", "knowledgeTitle": "加减消元法", "grade": "初一", "difficulty": 1, "type": "choice", "question": "解方程组：$\\begin{cases}2x+y=7\\\\x-y=2\\end{cases}$", "options": ["$x=3,\\ y=1$", "$x=1,\\ y=3$", "$x=2,\\ y=3$", "$x=3,\\ y=2$"], "answer": "$x=3,\\ y=1$", "solution": "两式相加消去 $y$：$3x=9$，$x=3$；代回得 $y=1$。", "source": "local"}, {"id": "EX_G7_ADD_SYS_02", "knowledgeTitle": "加减消元法", "grade": "初一", "difficulty": 2, "type": "choice", "question": "解方程组：$\\begin{cases}3x+2y=12\\\\3x-2y=0\\end{cases}$", "options": ["$x=2,\\ y=3$", "$x=3,\\ y=2$", "$x=2,\\ y=1$", "$x=4,\\ y=0$"], "answer": "$x=2,\\ y=3$", "solution": "两式相加：$6x=12$，$x=2$；代回 $3\\times2+2y=12$ 得 $y=3$。", "source": "local"}, {"id": "EX_G7_ADD_SYS_03", "knowledgeTitle": "加减消元法", "grade": "初一", "difficulty": 3, "type": "choice", "question": "解方程组：$\\begin{cases}4x+3y=18\\\\2x-3y=0\\end{cases}$", "options": ["$x=3,\\ y=2$", "$x=2,\\ y=3$", "$x=3,\\ y=1$", "$x=4,\\ y=2$"], "answer": "$x=3,\\ y=2$", "solution": "两式相加：$6x=18$，$x=3$；代回 $2\\times3-3y=0$ 得 $y=2$。", "source": "local"}, {"id": "EX_G7_INEQ_01", "knowledgeTitle": "一元一次不等式解集", "grade": "初一", "difficulty": 1, "type": "choice", "question": "解不等式：$2x-3<5$", "options": ["$x<4$", "$x>4$", "$x<1$", "$x>1$"], "answer": "$x<4$", "solution": "移项：$2x<8$，两边除以 $2$：$x<4$。", "source": "local"}, {"id": "EX_G7_INEQ_02", "knowledgeTitle": "一元一次不等式解集", "grade": "初一", "difficulty": 2, "type": "choice", "question": "解不等式：$-3x\\geq 9$", "options": ["$x\\leq -3$", "$x\\geq -3$", "$x\\leq 3$", "$x\\geq 3$"], "answer": "$x\\leq -3$", "solution": "两边除以 $-3$，不等号方向改变：$x\\leq -3$。", "source": "local"}, {"id": "EX_G7_INEQ_03", "knowledgeTitle": "一元一次不等式解集", "grade": "初一", "difficulty": 3, "type": "choice", "question": "解不等式：$2(x-1)\\leq 3x+1$", "options": ["$x\\geq -3$", "$x\\leq -3$", "$x\\geq 3$", "$x\\leq 3$"], "answer": "$x\\geq -3$", "solution": "去括号：$2x-2\\leq 3x+1$，移项得 $-3\\leq x$，即 $x\\geq -3$。", "source": "local"}]